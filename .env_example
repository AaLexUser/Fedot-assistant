# FedotLLM Environment Configuration
# Copy this file to .env and fill in the required values

# Main LLM API Configuration (for FedotLLM)
FEDOTLLM_LLM_MODEL=
FEDOTLLM_LLM_API_KEY=
FEDOTLLM_LLM_BASE_URL=

# CAAFE LLM Configuration (for feature generation)
# Optional - only needed if using CAAFE feature engineering
CAAFE_LLM_MODEL=
CAAFE_LLM_API_KEY=
CAAFE_LLM_BASE_URL=

# Langfuse Configuration (for observability/tracking)
# Optional - for monitoring LLM interactions
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

# Persistent data directory for cached sample datasets and sample_data.zip.
# Default: platform-specific path from platformdirs, e.g. ~/.local/share/fedotllm on Linux.
# FEDOTLLM_DATA_DIR=

# Per-session uploaded task data directory.
# Default: temp dir, e.g. /tmp/fedotllm/user_data on Linux or /var/folders/... on macOS.
# FEDOTLLM_UI_DATA_DIR=

# Trained model artifacts directory.
# Default: temp dir, e.g. /tmp/fedotllm/artifacts on Linux or /var/folders/... on macOS.
# FEDOTLLM_ARTIFACTS_DIR=

# FEDOT cache/history directory.
# Default: temp dir, e.g. /tmp/FEDOT on Linux or /var/folders/.../FEDOT on macOS.
# FEDOTLLM_FEDOT_DIR=

# Docker Configuration
# FEDOTLLM_PORT=8501  # Frontend port (default: 8501)
# FEDOTLLM_SERVER_PORT=8000  # Server port (default: 8000)
